# RuckZUG Cards — Beispiel-Umgebungsvariablen
# -------------------------------------------------------------------
# Kopiere diese Datei nach ".env" (am besten in den backend/-Ordner) und trage
# echte Werte ein. Die echte ".env" wird NIE committet (steht in .gitignore).
# Hier stehen ABSICHTLICH nur Variablennamen, KEINE Werte.

# --- Discord OAuth (Login, Phase 8) ---
# Aus dem Discord Developer Portal -> Application -> OAuth2.
# Das Client Secret bleibt serverseitig und darf NIE ins Frontend.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Muss EXAKT mit einer im Portal hinterlegten Redirect-URL übereinstimmen.
# Lokal:
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback

# Wohin nach erfolgreichem Login zurückgeleitet wird (die Website/Frontend).
# Lokal der Vite-Dev-Server:
FRONTEND_URL=http://localhost:5173

# --- Sitzungs-Signierung (Backend) ---
# Zufälliger, geheimer String zum Signieren der Session-Cookies.
# z.B. erzeugen mit:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Admin (Phase 13a) ---
# Kommaseparierte Discord-User-IDs, die Admin-Rechte haben (mehrere möglich).
# NUR diese user_ids sehen die Admin-Seite und dürfen die /api/admin/*-Endpoints
# aufrufen (serverseitig erzwungen, 403 für alle anderen).
# Beispiel: ADMIN_USER_IDS=123456789012345678,234567890123456789
ADMIN_USER_IDS=

# --- Dev-Endpoints ---
# Schaltet Test-Endpoints frei (aktuell /api/dev/login zum Einloggen ohne Discord).
# In Produktion LEER lassen / nicht setzen. Aktiv bei: 1, true, yes, on.
DEV_ENDPOINTS=

# --- Datenbank ---
# Pfad zur cards.db (wird vom Init-Skript erzeugt). Default: backend/cards.db
CARDS_DB_PATH=backend/cards.db
