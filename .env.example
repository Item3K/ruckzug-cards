# RuckZUG Cards — Beispiel-Umgebungsvariablen
# -------------------------------------------------------------------
# Kopiere diese Datei nach ".env" und trage echte Werte ein.
# Die echte ".env" wird NIE committet (steht in .gitignore).
# Hier stehen ABSICHTLICH nur Variablennamen, KEINE Werte.

# --- Discord OAuth (Login auf der Website, Phase 3) ---
# Aus dem Discord Developer Portal -> Application -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Muss exakt mit der im Developer Portal hinterlegten Redirect-URL übereinstimmen
DISCORD_REDIRECT_URI=

# --- Sitzungs-/Token-Signierung (Backend) ---
# Zufälliger, geheimer String zum Signieren von Sessions/JWTs
SESSION_SECRET=

# --- Datenbank ---
# Pfad zur cards.db (wird vom Init-Skript erzeugt). Default: backend/cards.db
CARDS_DB_PATH=backend/cards.db

# --- Backend-Server ---
# Host/Port, auf dem FastAPI lauscht (lokal)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Frontend ---
# Basis-URL des Backends, die das Frontend anspricht (für Vite-Proxy/Fetch)
VITE_API_BASE_URL=http://127.0.0.1:8000
